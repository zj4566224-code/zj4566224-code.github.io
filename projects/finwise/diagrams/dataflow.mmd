flowchart TB
    Start(["<b>① 用户说一句话</b> ·『昨天午饭 35』<br/>前端 QuickAddBar 发起 useParseTransaction<br/>POST /ai/parse-transaction(带 JWT)"])

    Auth{"<b>安全关卡 ①</b> · JWT 有效?"}
    AuthFail["返回 401 · 跳转登录"]

    LLMStep["<b>② 后端取数 + 调用大模型</b><br/>build_user_context 取该用户分类/账户<br/>→ DeepSeek 用 tool_choice 强制结构化<br/>→ 口语转成 JSON 草稿(解析失败则提示换说法)"]
    ParseFail["解析失败<br/>提示换种说法"]

    Valid{"<b>安全关卡 ②</b> · category 属于当前用户?"}
    ValidFail["返回 422 · 引导手动选分类<br/>(防 LLM 越权 / 编造)"]

    Preview["<b>③ 前端预览卡</b> · 显示金额 / 分类 / 日期<br/>+ 置信度色带(<0.8 标橙提醒用户检查)"]

    Commit(["<b>④ 用户点『确认入账』</b><br/>useCreateTransaction → POST /transactions<br/>→ SQLAlchemy 写入 PostgreSQL<br/>→ invalidateQueries 刷新列表/仪表盘/预算"])

    Start --> Auth
    Auth -->|"无效"| AuthFail
    Auth -->|"有效"| LLMStep
    LLMStep -->|"解析失败"| ParseFail
    LLMStep -->|"解析成功"| Valid
    Valid -->|"不属于"| ValidFail
    Valid -->|"通过"| Preview --> Commit

